generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            BigInt    @id @default(autoincrement())
  username      String    @unique @db.VarChar(50)
  email         String    @unique @db.VarChar(100)
  passwordHash  String    @map("password_hash") @db.VarChar(255)
  avatar        String?   @db.VarChar(255)
  bio           String?   @db.Text
  role          SystemRole @default(USER)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("users")

  ownedProjects   Project[]       @relation("ProjectOwner")
  projectMembers  ProjectMember[]
  createdCharacters Character[]

  createdLocations Location[]
  createdFactions Faction[]
  createdEvents Event[]
  createdLoreEntries LoreEntry[]
}

enum SystemRole {
  USER
  ADMIN
}

model Project {
  id          BigInt   @id @default(autoincrement())
  ownerId     BigInt   @map("owner_id")
  name        String   @db.VarChar(150)
  description String?  @db.Text
  coverImage  String?  @map("cover_image") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  owner   User            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members ProjectMember[]

  @@map("projects")

  characters Character[]

  locations Location[]

  factions Faction[]

  events Event[]

  loreEntries LoreEntry[]

  relations CharacterRelation[]

  mapImageUrl String?     @map("map_image_url") @db.VarChar(500)
  mapMarkers  MapMarker[]
}

model ProjectMember {
  id        BigInt      @id @default(autoincrement())
  projectId BigInt      @map("project_id")
  userId    BigInt      @map("user_id")
  role      ProjectRole @default(VIEWER)
  joinedAt  DateTime    @default(now()) @map("joined_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

enum ProjectRole {
  OWNER
  EDITOR
  AUTHOR
  VIEWER
}

model Character {
  id          BigInt    @id @default(autoincrement())
  projectId   BigInt    @map("project_id")
  name        String    @db.VarChar(100)
  portrait    String?   @db.VarChar(255)
  description String?   @db.Text
  biography   String?   @db.Text
  role        String?   @db.VarChar(50)
  alignment   Alignment @default(NEUTRAL)
  createdBy   BigInt    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [createdBy], references: [id])

  @@index([projectId])
  @@map("characters")

  locations CharacterLocation[]

  factions CharacterFaction[]

  events EventCharacter[]

  relationsFrom CharacterRelation[] @relation("RelationFrom")
relationsTo   CharacterRelation[] @relation("RelationTo")
}

enum Alignment {
  POSITIVE
  NEGATIVE
  NEUTRAL
}

model Location {
  id          BigInt   @id @default(autoincrement())
  projectId   BigInt   @map("project_id")
  parentId    BigInt?  @map("parent_id")
  name        String   @db.VarChar(100)
  type        String?  @db.VarChar(50)
  population  Int?
  image       String?  @db.VarChar(255)
  description String?  @db.Text
  history     String?  @db.Text
  createdBy   BigInt   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author             User                @relation(fields: [createdBy], references: [id])
  parent             Location?           @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children           Location[]          @relation("LocationHierarchy")
  characterLocations CharacterLocation[]

  @@index([projectId])
  @@index([parentId])
  @@map("locations")
  
  events Event[]

  mapMarker MapMarker?
}

model CharacterLocation {
  id          BigInt  @id @default(autoincrement())
  characterId BigInt  @map("character_id")
  locationId  BigInt  @map("location_id")
  type        String? @db.VarChar(50)

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  location  Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([characterId, locationId, type])
  @@map("character_locations")
}

model Faction {
  id          BigInt   @id @default(autoincrement())
  projectId   BigInt   @map("project_id")
  name        String   @db.VarChar(100)
  symbol      String?  @db.VarChar(255)
  description String?  @db.Text
  history     String?  @db.Text
  leader      String?  @db.VarChar(150)
  territory   String?  @db.VarChar(150)
  createdBy   BigInt   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project            Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author             User               @relation(fields: [createdBy], references: [id])
  characterFactions  CharacterFaction[]

  @@index([projectId])
  @@map("factions")
}

model CharacterFaction {
  id          BigInt  @id @default(autoincrement())
  characterId BigInt  @map("character_id")
  factionId   BigInt  @map("faction_id")
  role        String? @db.VarChar(50)

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  faction   Faction   @relation(fields: [factionId], references: [id], onDelete: Cascade)

  @@unique([characterId, factionId])
  @@map("character_factions")
}

model Event {
  id          BigInt   @id @default(autoincrement())
  projectId   BigInt   @map("project_id")
  title       String   @db.VarChar(150)
  date        String?  @db.VarChar(100)
  description String?  @db.Text
  locationId  BigInt?  @map("location_id")
  createdBy   BigInt   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  location   Location?        @relation(fields: [locationId], references: [id], onDelete: SetNull)
  author     User             @relation(fields: [createdBy], references: [id])
  characters EventCharacter[]

  @@index([projectId])
  @@index([locationId])
  @@map("events")
}

model EventCharacter {
  id          BigInt  @id @default(autoincrement())
  eventId     BigInt  @map("event_id")
  characterId BigInt  @map("character_id")
  role        String? @db.VarChar(50)

  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([eventId, characterId])
  @@map("event_characters")
}

model LoreEntry {
  id        BigInt   @id @default(autoincrement())
  projectId BigInt   @map("project_id")
  title     String   @db.VarChar(150)
  category  String?  @db.VarChar(50)
  content   String?  @db.Text
  createdBy BigInt   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [createdBy], references: [id])

  @@index([projectId])
  @@index([category])
  @@map("lore_entries")
  
}

model CharacterRelation {
  id              BigInt       @id @default(autoincrement())
  projectId       BigInt       @map("project_id")
  characterFromId BigInt       @map("character_from_id")
  characterToId   BigInt       @map("character_to_id")
  type            RelationType
  description     String?      @db.Text
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  characterFrom Character @relation("RelationFrom", fields: [characterFromId], references: [id], onDelete: Cascade)
  characterTo   Character @relation("RelationTo", fields: [characterToId], references: [id], onDelete: Cascade)

  @@unique([projectId, characterFromId, characterToId, type])
  @@index([projectId])
  @@index([characterFromId])
  @@index([characterToId])
  @@map("character_relations")
}

enum RelationType {
  FRIEND
  ENEMY
  FAMILY
  ALLY
  RIVAL
  MENTOR
  ROMANTIC
  OTHER
}

model MapMarker {
  id         BigInt   @id @default(autoincrement())
  projectId  BigInt   @map("project_id")
  locationId BigInt   @map("location_id")
  x          Float
  y          Float
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId])
  @@index([projectId])
  @@map("map_markers")
}