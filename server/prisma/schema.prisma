generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            BigInt    @id @default(autoincrement())
  username      String    @unique @db.VarChar(50)
  email         String    @unique @db.VarChar(100)
  passwordHash  String    @map("password_hash") @db.VarChar(255)
  avatar        String?   @db.VarChar(255)
  bio           String?   @db.Text
  role          SystemRole @default(USER)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("users")

  ownedProjects   Project[]       @relation("ProjectOwner")
  projectMembers  ProjectMember[]
  createdCharacters Character[]

  createdLocations Location[]
  createdFactions Faction[]
}

enum SystemRole {
  USER
  ADMIN
}

model Project {
  id          BigInt   @id @default(autoincrement())
  ownerId     BigInt   @map("owner_id")
  name        String   @db.VarChar(150)
  description String?  @db.Text
  coverImage  String?  @map("cover_image") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  owner   User            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members ProjectMember[]

  @@map("projects")

  characters Character[]

  locations Location[]

  factions Faction[]
}

model ProjectMember {
  id        BigInt      @id @default(autoincrement())
  projectId BigInt      @map("project_id")
  userId    BigInt      @map("user_id")
  role      ProjectRole @default(VIEWER)
  joinedAt  DateTime    @default(now()) @map("joined_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

enum ProjectRole {
  OWNER
  EDITOR
  AUTHOR
  VIEWER
}

model Character {
  id          BigInt    @id @default(autoincrement())
  projectId   BigInt    @map("project_id")
  name        String    @db.VarChar(100)
  portrait    String?   @db.VarChar(255)
  description String?   @db.Text
  biography   String?   @db.Text
  role        String?   @db.VarChar(50)
  alignment   Alignment @default(NEUTRAL)
  createdBy   BigInt    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [createdBy], references: [id])

  @@index([projectId])
  @@map("characters")

  locations CharacterLocation[]

  factions CharacterFaction[]
}

enum Alignment {
  POSITIVE
  NEGATIVE
  NEUTRAL
}

model Location {
  id          BigInt   @id @default(autoincrement())
  projectId   BigInt   @map("project_id")
  parentId    BigInt?  @map("parent_id")
  name        String   @db.VarChar(100)
  type        String?  @db.VarChar(50)
  population  Int?
  image       String?  @db.VarChar(255)
  description String?  @db.Text
  history     String?  @db.Text
  createdBy   BigInt   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author             User                @relation(fields: [createdBy], references: [id])
  parent             Location?           @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children           Location[]          @relation("LocationHierarchy")
  characterLocations CharacterLocation[]

  @@index([projectId])
  @@index([parentId])
  @@map("locations")
}

model CharacterLocation {
  id          BigInt  @id @default(autoincrement())
  characterId BigInt  @map("character_id")
  locationId  BigInt  @map("location_id")
  type        String? @db.VarChar(50)

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  location  Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([characterId, locationId, type])
  @@map("character_locations")
}

model Faction {
  id          BigInt   @id @default(autoincrement())
  projectId   BigInt   @map("project_id")
  name        String   @db.VarChar(100)
  symbol      String?  @db.VarChar(255)
  description String?  @db.Text
  history     String?  @db.Text
  leader      String?  @db.VarChar(150)
  territory   String?  @db.VarChar(150)
  createdBy   BigInt   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project            Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author             User               @relation(fields: [createdBy], references: [id])
  characterFactions  CharacterFaction[]

  @@index([projectId])
  @@map("factions")
}

model CharacterFaction {
  id          BigInt  @id @default(autoincrement())
  characterId BigInt  @map("character_id")
  factionId   BigInt  @map("faction_id")
  role        String? @db.VarChar(50)

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  faction   Faction   @relation(fields: [factionId], references: [id], onDelete: Cascade)

  @@unique([characterId, factionId])
  @@map("character_factions")
}